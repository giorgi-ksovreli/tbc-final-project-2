<suite name="TBC Suite" parallel="tests" thread-count="3">

    <test name="Chromium">
        <parameter name="browser" value="chromium"/>
        <parameter name="mobile" value="false"/>
        <classes>
            <class name="tests.GlobalNavigationTest"/>
            <class name="tests.LocationFilterTest"/>
            <class name="tests.OfferTest"/>
            <class name="tests.SearchTest"/>
            <class name="tests.ZoomTest"/>
        </classes>
    </test>

    <test name="Mobile">
        <parameter name="browser" value="chromium"/>
        <parameter name="mobile" value="true"/>
        <classes>
            <class name="tests.OfferTest"/>
        </classes>
    </test>

</suite>